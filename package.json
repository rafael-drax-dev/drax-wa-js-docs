{
  "name": "drax-wa-js-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name drax-wa-js",
    "check": "node scripts/check.mjs",
    "check:built": "node scripts/check.mjs --built",
    "prebuild": "npm run check",
    "postbuild": "npm run check:built"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.2.10"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
